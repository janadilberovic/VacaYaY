# Copy to web/.env and fill in an existing HR account that already has a real password set
# (an account still on its TempPassword is redirected to /change-password and breaks the setup).
E2E_HR_EMAIL=
E2E_HR_PASSWORD=

# A non-HR account, used only by permissions.spec.ts.
E2E_EMPLOYEE_EMAIL=
E2E_EMPLOYEE_PASSWORD=
